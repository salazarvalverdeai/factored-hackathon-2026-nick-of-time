{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Held-out evaluation case (team-generated). The harness compares FINAL STATE, not text.",
  "type": "object",
  "required": [
    "id",
    "language",
    "type",
    "origin",
    "initial_state",
    "messages",
    "expected",
    "set"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EV-[0-9]{4}$"
    },
    "language": {
      "enum": [
        "es",
        "pt",
        "mixed"
      ]
    },
    "type": {
      "enum": [
        "normal",
        "ambiguous",
        "human",
        "injection",
        "session_expired",
        "unauthorized_access",
        "tool_failure",
        "missing_data",
        "late_arrival",
        "out_of_scope",
        "cap",
        "customer_returns"
      ]
    },
    "origin": {
      "enum": [
        "team-generated",
        "external-translated"
      ],
      "description": "never the dataset: it has no real text"
    },
    "segment": {
      "enum": [
        "Premium",
        "Plus",
        "Basic",
        "Student"
      ]
    },
    "country": {
      "enum": [
        "MX",
        "CO",
        "AR",
        "BR"
      ]
    },
    "initial_state": {
      "type": "object",
      "required": [
        "customer_id",
        "session"
      ],
      "properties": {
        "customer_id": {
          "type": "string"
        },
        "session": {
          "enum": [
            "verified",
            "expired",
            "none"
          ]
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "transaction fixtures with transaction_id, amount, transaction_date, fraud_score"
        },
        "tool_faults": {
          "type": "array",
          "items": {
            "enum": [
              "block_card",
              "open_case",
              "search_transaction"
            ]
          }
        },
        "case_id": {
          "type": "string",
          "pattern": "^K-[0-9]{6}$",
          "description": "returning customer (customer_returns): the case they already have; the seed maps it to a fresh id per run"
        },
        "case": {
          "type": "object",
          "description": "fixture of the existing case; deadlines come from the clock at opened_on",
          "required": [
            "transaction_id",
            "dispute_type",
            "zone",
            "queue_status",
            "opened_on"
          ],
          "properties": {
            "transaction_id": {
              "type": "string"
            },
            "dispute_type": {
              "enum": [
                "unrecognized_charge",
                "wrongful_charge"
              ]
            },
            "zone": {
              "enum": [
                "high",
                "medium",
                "human"
              ]
            },
            "queue_status": {
              "enum": [
                "new",
                "verification",
                "review",
                "resolved",
                "closed"
              ]
            },
            "opened_on": {
              "type": "string",
              "format": "date"
            }
          },
          "additionalProperties": false
        }
      },
      "dependentRequired": {
        "case_id": [
          "case"
        ],
        "case": [
          "case_id"
        ]
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "text"
        ],
        "properties": {
          "role": {
            "enum": [
              "customer",
              "system"
            ]
          },
          "text": {
            "type": "string",
            "description": "customer-facing: stays in Spanish/Portuguese"
          },
          "chip": {
            "type": "string",
            "description": "D-071 (spec 10 AC-14): the id of a chip of the last reply that the customer presses; the harness sends it as the web does (an action chip's action, a text chip's label); `text` is its label, for the record"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "required": [
        "decision"
      ],
      "properties": {
        "decision": {
          "enum": [
            "block_and_open_case",
            "confirm",
            "ask",
            "handoff",
            "answer_status",
            "connect_person",
            "deny",
            "reauthenticate",
            "escalate_unconfirmed_action"
          ]
        },
        "zone": {
          "enum": [
            "high",
            "medium",
            "human",
            null
          ]
        },
        "intent": {
          "enum": [
            "unrecognized_charge",
            "wrongful_charge",
            "status_inquiry",
            "human_request",
            "out_of_scope"
          ]
        },
        "receipt": {
          "type": "object",
          "required": [
            "issued",
            "has_deadline"
          ],
          "properties": {
            "issued": {
              "type": "boolean"
            },
            "has_deadline": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "final_state": {
          "type": "object",
          "properties": {
            "product_status": {
              "type": "string"
            },
            "case_open": {
              "type": "boolean"
            },
            "handoff_emitted": {
              "type": "boolean"
            },
            "other_customer_data_exposed": {
              "const": false
            }
          }
        },
        "deadline_country": {
          "type": "string"
        },
        "guardrail_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^G-[A-Z]+-[0-9]{2}$"
          },
          "description": "guardrails that must fire (policies.yaml)"
        },
        "queue_status": {
          "enum": [
            "new",
            "verification",
            "review",
            "resolved",
            "closed"
          ]
        },
        "notifications": {
          "type": "array",
          "items": {
            "enum": [
              "case_opened",
              "card_blocked",
              "in_review",
              "resolved"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "labeler": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string",
      "description": "second person on a sample: measures agreement"
    },
    "set": {
      "enum": [
        "dev",
        "heldout"
      ],
      "description": "dev uses customers from partition 7; heldout only 8-9 and is sealed on Thursday"
    },
    "variant_of": {
      "type": "string",
      "pattern": "^EV-[0-9]{4}$",
      "description": "D-071 (spec 09 §7.4): a dev recovery variant of that case: its messages plus the customer's answer to the ask; scored apart (spec 10 second_turn_recovery), never in the §4.1 metrics"
    },
    "second_turn": {
      "enum": [
        "typed",
        "chip"
      ],
      "description": "D-071: how the variant's last message answers the ask: typed text or a chip press"
    }
  }
}
