# secrets
.env
*.pem

# data: nothing from the dataset goes into git. The pipeline code, the synthetic fixtures, the generated report
# and the gold manifest do go in; data/gold and data/gold_eval (Parquet) stay out.
data/*
!data/pipeline/
!data/fixtures/
!data/quality_report.md
!data/gold/
data/gold/*
!data/gold/manifest.json
*.parquet
*.duckdb
*.duckdb.wal

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# system
.DS_Store
