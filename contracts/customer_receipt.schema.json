{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer receipt — the verified proof the customer keeps (spec 01 §6.7; ADRs 0013, 0016, 0019)",
  "description": "Built by nick_of_time.receipt from tool results only. Never carries score, policy ids or transcript (policies.yaml notifications.never_send). Optional fields may be null or absent. Python mirror: nick_of_time.contracts.CustomerReceipt. The example is a fixture [simulated].",
  "type": "object",
  "required": ["receipt_id", "case_id", "language", "issued_at", "verified_facts", "actions", "deadline", "what_ai_did", "what_a_person_does"],
  "additionalProperties": false,
  "properties": {
    "receipt_id": {"type": "string", "pattern": "^RC-[0-9A-F]{12}$"},
    "case_id": {"type": "string", "pattern": "^K-[0-9]{6}$"},
    "language": {"enum": ["es", "pt"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "verified_facts": {
      "type": "array",
      "items": {
        "type": "object", "required": ["fact", "source_id"], "additionalProperties": false,
        "properties": {
          "fact": {"type": "string"},
          "source_id": {"type": "string", "description": "transaction or product id from gold, or a V-/K- id"}
        }
      }
    },
    "mode": {"enum": ["replay", "live", null]},
    "product_last4": {"type": ["string", "null"], "pattern": "^[0-9]{4}$"},
    "amount": {
      "type": ["object", "null"], "required": ["original"], "additionalProperties": false,
      "properties": {
        "original": {"$ref": "#/$defs/money"},
        "display": {
          "description": "approximation from convert_amount; null or absent when no verified rate exists (ADR 0019)",
          "type": ["object", "null"], "required": ["amount", "currency", "rate", "rate_source", "as_of"],
          "additionalProperties": false,
          "properties": {
            "amount": {"$ref": "#/$defs/decimal"},
            "currency": {"$ref": "#/$defs/currency"},
            "rate": {"$ref": "#/$defs/decimal"},
            "rate_source": {"type": "string"},
            "as_of": {"type": "string", "format": "date"}
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["label", "action_id", "state"], "additionalProperties": false,
        "properties": {
          "label": {"type": "string"},
          "action_id": {"type": "string", "pattern": "^A-[0-9A-F]{12}$"},
          "state": {"enum": ["in_progress", "requested", "verified", "not_confirmed"]},
          "verification_id": {"type": ["string", "null"], "pattern": "^V-[0-9A-F]{12}$"},
          "verified_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "deadline": {
      "description": "null for a country without a verified clock entry (POL-CLOCK-UNKNOWN)",
      "type": ["object", "null"],
      "required": ["country", "product", "deadline_source", "source_url", "verified_on"],
      "additionalProperties": false,
      "properties": {
        "country": {"type": "string"},
        "product": {"type": "string"},
        "credit_deadline": {"$ref": "#/$defs/date_or_null"},
        "ruling_deadline": {"$ref": "#/$defs/date_or_null"},
        "deadline_source": {"type": "string"},
        "source_url": {"type": "string"},
        "verified_on": {"type": "string", "format": "date"}
      }
    },
    "what_ai_did": {"type": "string"},
    "what_a_person_does": {"type": "string"},
    "next_steps": {"type": "array", "items": {"type": "string"}},
    "case_url": {"type": ["string", "null"]}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "money": {
      "type": "object", "required": ["amount", "currency"], "additionalProperties": false,
      "properties": {"amount": {"$ref": "#/$defs/decimal"}, "currency": {"$ref": "#/$defs/currency"}}
    },
    "date_or_null": {"type": ["string", "null"], "format": "date"}
  },
  "examples": [
    {
      "receipt_id": "RC-5F1C0A93D2E4",
      "case_id": "K-104233",
      "language": "es",
      "issued_at": "2026-06-03T15:04:12Z",
      "mode": "replay",
      "product_last4": "4417",
      "verified_facts": [
        {"fact": "Cargo no reconocido: MXN 1,250.00 · 2026-05-28 · TIENDA X.", "source_id": "T-77120"},
        {"fact": "Tarjeta de débito ····4417 bloqueada.", "source_id": "V-8B2D41C7E0A9"},
        {"fact": "Caso K-104233 abierto.", "source_id": "K-104233"}
      ],
      "amount": {"original": {"amount": "1250.00", "currency": "MXN"}, "display": null},
      "actions": [
        {"label": "Tarjeta bloqueada", "action_id": "A-3E9F20B7C164", "state": "verified", "verification_id": "V-8B2D41C7E0A9", "verified_at": "2026-06-03T15:04:09Z"},
        {"label": "Caso abierto", "action_id": "A-71C0D5E8A2F3", "state": "verified", "verification_id": "V-0C6A93F1B57D", "verified_at": "2026-06-03T15:04:11Z"}
      ],
      "deadline": {
        "country": "MX", "product": "debit", "credit_deadline": "2026-06-05", "ruling_deadline": null,
        "deadline_source": "Banxico Circular 3/2012, art. 19 Bis 3",
        "source_url": "https://www.gob.mx/condusef/articulos/cargos-no-reconocidos?idiom=es",
        "verified_on": "2026-09-28"
      },
      "what_ai_did": "El asistente automático identificó tu cargo, bloqueó tu tarjeta ····4417 y abrió el caso K-104233. Cada acción quedó verificada.",
      "what_a_person_does": "Una persona del banco revisa tu caso y toma la decisión final.",
      "next_steps": ["No necesitas hacer nada más por ahora.", "En el enlace puedes ver tu caso o agregar información.", "Te avisaremos de cada cambio de estado."],
      "case_url": "https://nickoftime.salazarvalverdeai.com/case/K-104233"
    }
  ]
}
