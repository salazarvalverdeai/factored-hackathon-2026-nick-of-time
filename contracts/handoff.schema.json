{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff card — what the human receives (never the raw transcript)",
  "type": "object",
  "required": [
    "case_id",
    "language",
    "zone",
    "request",
    "verified_facts",
    "actions",
    "evidence",
    "open_questions",
    "deadline",
    "trace_id"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "language": {
      "enum": [
        "es",
        "pt"
      ]
    },
    "zone": {
      "enum": [
        "high",
        "medium",
        "human"
      ]
    },
    "handoff_reason": {
      "enum": [
        "zone_human",
        "zone_medium",
        "supervised_mode",
        "amount_over_case_gate",
        "identity_unverified",
        "clarification_exhausted",
        "tool_failure",
        "language_low_confidence"
      ]
    },
    "request": {
      "type": "string",
      "description": "one sentence written by the system: type, amount, date, merchant"
    },
    "verified_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact",
          "source_id"
        ],
        "properties": {
          "fact": {
            "type": "string"
          },
          "source_id": {
            "type": "string",
            "description": "transaction_id, product_id, session_id, rule_id"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "action_id",
          "result",
          "verified"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "action_id": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "verification_id": {
            "type": "string"
          }
        },
        "if": {
          "required": ["verified"],
          "properties": {"verified": {"const": true}}
        },
        "then": {
          "required": ["verification_id"],
          "properties": {"verification_id": {"pattern": "^V-[0-9A-F]{12}$"}}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs: TRX-, PRD-, CLI- (gold ids, unchanged), A-, V-, RC-, K-"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "copilot_proposal": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "approve_credit",
            "approve_block",
            "request_customer_info",
            "close_without_action"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "requires_human": {
          "const": true
        }
      }
    },
    "deadline": {
      "type": "object",
      "required": [
        "country",
        "deadline_source"
      ],
      "if": {
        "anyOf": [{"required": ["credit_deadline"]}, {"required": ["ruling_deadline"]}]
      },
      "then": {
        "required": ["source_url", "verified_on"]
      },
      "properties": {
        "country": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "credit_deadline": {
          "type": "string",
          "format": "date"
        },
        "ruling_deadline": {
          "type": "string",
          "format": "date"
        },
        "deadline_source": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "verified_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "auth_evidence": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional. Proxy for two-factor authentication evidence (MX debit exemption, policies.yaml regulatory_clock.MX.debit). The dataset has no chip/PIN/3DS, so it is derived from transactions.channel; null when the transaction has no channel.",
      "required": [
        "proxy",
        "channel",
        "source_id"
      ],
      "properties": {
        "proxy": {
          "const": "channel"
        },
        "channel": {
          "type": "string"
        },
        "source_id": {
          "type": "string",
          "description": "transaction_id the channel was read from"
        }
      },
      "additionalProperties": false
    },
    "trace_id": {
      "type": "string"
    },
    "score": {
      "type": [
        "number",
        "null"
      ]
    },
    "intent_confidence": {
      "type": "number"
    },
    "queue_status": {
      "enum": [
        "new",
        "verification",
        "review",
        "resolved",
        "closed"
      ]
    },
    "notifications_sent": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "delivered": {
            "type": "boolean"
          },
          "ts": {
            "type": "string"
          }
        }
      }
    },
    "guardrails_triggered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
