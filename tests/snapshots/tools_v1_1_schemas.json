{
 "customer_tools": {
  "add_case_info": {
   "in": {
    "additionalProperties": false,
    "properties": {
     "case_id": {
      "pattern": "^K-[0-9]{6}$",
      "title": "Case Id",
      "type": "string"
     },
     "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
     },
     "session_id": {
      "pattern": "^S-[A-Za-z0-9_-]{16}$",
      "title": "Session Id",
      "type": "string"
     },
     "text": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
     }
    },
    "required": [
     "session_id",
     "idempotency_key",
     "case_id",
     "text"
    ],
    "title": "AddCaseInfoIn",
    "type": "object"
   },
   "out": {
    "additionalProperties": false,
    "properties": {
     "action_id": {
      "pattern": "^A-[0-9A-F]{12}$",
      "title": "Action Id",
      "type": "string"
     },
     "case_id": {
      "anyOf": [
       {
        "pattern": "^K-[0-9]{6}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Case Id"
     },
     "event_id": {
      "pattern": "^E-[0-9A-F]{12}$",
      "title": "Event Id",
      "type": "string"
     },
     "state": {
      "const": "requested",
      "default": "requested",
      "title": "State",
      "type": "string"
     }
    },
    "required": [
     "action_id",
     "event_id"
    ],
    "title": "AddCaseInfoOut",
    "type": "object"
   }
  },
