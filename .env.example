# Copy to .env (never committed). No secrets here: credentials live in ~/.aws/credentials profiles.

# Team AWS account (Bedrock, DynamoDB, team S3). Profile created with `aws configure --profile nickoftime`.
AWS_PROFILE=nickoftime
AWS_REGION=us-east-2

# Read-only access to the Factored dataset bucket (keys from the data dictionary, page 2), stored as its own profile:
#   aws configure --profile factored-dataset
DATASET_AWS_PROFILE=factored-dataset
DATASET_S3_BUCKET=factored-datathon-2026-s3-157725502942-us-east-2-an
DATASET_S3_PREFIX=data/

# Team gold bucket (created by the AWS setup; replace <ACCOUNT_ID>)
GOLD_S3_URI=s3://nickoftime-gold-<ACCOUNT_ID>/gold/

LOCAL_DATA_DIR=data
