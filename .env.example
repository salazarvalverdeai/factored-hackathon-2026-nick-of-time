# Copy to .env (never committed). No secrets here: credentials live in ~/.aws/credentials profiles.

# Team AWS account (Bedrock, DynamoDB, team S3). Profile created with `aws configure --profile nickoftime`.
AWS_PROFILE=nickoftime
AWS_REGION=us-east-2

# Read-only access to the Factored dataset bucket (keys from the data dictionary, page 2), stored as its own profile:
#   aws configure --profile factored-dataset
DATASET_AWS_PROFILE=factored-dataset
DATASET_S3_BUCKET=factored-datathon-2026-s3-157725502942-us-east-2-an
DATASET_S3_PREFIX=data/

# Team gold bucket (created by the AWS setup; replace <ACCOUNT_ID>)
GOLD_S3_URI=s3://nickoftime-gold-<ACCOUNT_ID>/gold/v1/

LOCAL_DATA_DIR=data

# Integrations — fill only in your local .env; production values live in SSM under /nickoftime/prod/* (docs/runbooks/).
# Each block ends with an access check: make check-bedrock | check-telegram | check-resend | check-jev
BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_GRAPH=us.anthropic.claude-sonnet-4-6

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

RESEND_API_KEY=
RESEND_FROM=Nick of Time <avisos@notify.nickoftime.salazarvalverdeai.com>

TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

LANGSMITH_API_KEY=
